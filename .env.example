# Copy to `.env` and adjust. Docker Compose loads `.env` automatically for
# ${VAR} substitution in docker-compose.yml.

# CIRU_TAG=vision
# CIRU_PORT=8000
# CIRU_HOST=0.0.0.0

# Host GPU group IDs (getent group video/render) — required for /dev/dri + /dev/kfd.
VIDEO_GID=44
RENDER_GID=992

# Hugging Face token — optional for this public model; helps with Hub rate limits.
# HF_TOKEN=hf_...

# HF_REPO=jcbtc/Ornith1.5-Ciru-Halo-Agent-vllm-strix-halo
