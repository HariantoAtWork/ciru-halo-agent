# Ornith1.5 Ciru Halo Agent — custom vLLM/ROCm10 stack (not stock vLLM).
# First start downloads HF bundle (~24 GB) + installs wheel runtime on volumes.
# Needs ~100 GB host RAM (Strix Halo 128 GB UM). Default CMD is serve-vision.
#
# Named volumes keep stable names across compose project renames so existing
# ciru-bundle / ciru-runtime data from the former unsloth-amd layout still mounts.

services:
  ciru-halo-agent:
    container_name: ciru-halo-agent
    image: harianto/ciru-halo-agent:${CIRU_TAG:-vision}
    # ROCm/KFD needs host device groups + relaxed seccomp (default profile SEGV).
    privileged: true
    group_add:
      - "${VIDEO_GID:-44}"
      - "${RENDER_GID:-992}"
    devices:
      - /dev/kfd
      - /dev/dri
    device_cgroup_rules:
      - "c 226:* rmw"
      - "c 234:* rmw"
    security_opt:
      - seccomp:unconfined
      - apparmor:unconfined
    volumes:
      - ciru-bundle:/opt/ciru-halo-agent
      - ciru-runtime:/opt/ciru-runtime
      - ciru-cache:/root/.cache
      # uv keeps CPython here; without this, recreate breaks venv/bin/python.
      - ciru-uv:/root/.local/share
      # Clear stale Ornith optimized-runtime/<pid> dirs on every start (exist_ok=False crash).
      - ./build/ciru-halo-agent/docker-entrypoint.sh:/usr/local/bin/docker-entrypoint.sh:ro
    ipc: host
    shm_size: "32gb"
    ulimits:
      memlock: -1
      stack: 67108864
    stdin_open: true
    tty: true
    # ports:
    #   - "${CIRU_PORT:-8000}:${CIRU_PORT:-8000}"
    environment:
      CIRU_HOST: "${CIRU_HOST:-0.0.0.0}"
      CIRU_PORT: "${CIRU_PORT:-8000}"
      ORNITH_RUNTIME_ROOT: /opt/ciru-runtime/installed
      ORNITH_OPTIMIZED_CACHE: /opt/ciru-halo-agent/bundle/cache
      HF_REPO: "${HF_REPO:-jcbtc/Ornith1.5-Ciru-Halo-Agent-vllm-strix-halo}"
      CIRU_TARGET_BUNDLE_VERSION: "${CIRU_TARGET_BUNDLE_VERSION:-4.1.1}"
      # Optional — public repo works without it; raises Hub rate limits when set.
      HF_TOKEN: "${HF_TOKEN:-}"
      # Strix Halo / gfx1151 — native arch; SVM+XNACK (do not set HSA_OVERRIDE_GFX_VERSION).
      HIP_VISIBLE_DEVICES: "0"
      ROCR_VISIBLE_DEVICES: "0"
      HSA_ENABLE_SDMA: "0"
      HSA_USE_SVM: "1"
      HSA_XNACK: "1"
      PYTORCH_ROCM_ARCH: gfx1151
      GPU_ARCHS: gfx1151
      AMD_SERIALIZE_KERNEL: "3"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:${CIRU_PORT:-8000}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 60
      start_period: 90m
    # Stop infinite restart spam when the host GPU stack rejects Ciru ROCm10.
    restart: on-failure:3

volumes:
  ciru-bundle:
    name: ciru-bundle
  ciru-runtime:
    name: ciru-runtime
  ciru-cache:
    name: ciru-cache
  ciru-uv:
    name: ciru-uv
